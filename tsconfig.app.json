{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // onnxruntime-web ships types but its package.json "exports" map has no
    // "types" condition, so Bundler resolution cannot reach them. Point at the
    // declaration file directly until upstream adds the condition.
    "paths": {
      "onnxruntime-web": ["./node_modules/onnxruntime-web/types.d.ts"]
    }
  },
  "include": ["src"]
}
