<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <WasmMainJSPath>main.js</WasmMainJSPath>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- SMA is reflection-heavy; trimming it is the documented hazard. -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Plain .dll instead of webcil, so an assembly can be injected by hand. -->
    <WasmEnableWebcil>false</WasmEnableWebcil>
    <!-- PowerShell.Invoke blocks the caller while the pipeline completes, which
         deadlocks single-threaded. Needs SharedArrayBuffer, so the host must
         send COOP/COEP. Experimental in .NET 8. -->
    <WasmEnableThreads>false</WasmEnableThreads>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>
  <ItemGroup>
    <!-- No PackageReference for SMA: the NuGet reference assembly would win
         for compile and it does not carry the port's additions (HuskHostHook).
         The patched build is the only SMA this app should see. -->
    <!-- browser-wasm has no runtime asset in the package; the unix build is
         pure managed IL, so try loading that one directly. -->
    <Reference Include="System.Management.Automation">
      <HintPath>SMA-unix.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- The wasm SDK builds its assembly list from runtime-pack + package
       runtime assets. A bare <Reference> never reaches it, so name the
       assembly explicitly for bundling. -->
</Project>
