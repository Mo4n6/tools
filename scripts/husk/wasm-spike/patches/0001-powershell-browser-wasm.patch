diff --git a/src/System.Management.Automation/engine/runtime/Binding/Binders.cs b/src/System.Management.Automation/engine/runtime/Binding/Binders.cs
index 0a4fafd..d8daede 100644
--- a/src/System.Management.Automation/engine/runtime/Binding/Binders.cs
+++ b/src/System.Management.Automation/engine/runtime/Binding/Binders.cs
@@ -7044,7 +7044,48 @@ namespace System.Management.Automation.Language
             return result;
         }
 
+        // wasm port: the chokepoint for compiled script.
+        //
+        // The DLR binder emits a direct call to the resolved method, so the
+        // interpreted path in CoreAdapter never runs here. Wrapping the
+        // generated expression means a host-reaching call is recorded however
+        // the script reached it - [Net.WebClient]::new(), a cmdlet fetched by
+        // reference, or a proxy the sample deleted. A bypass should produce a
+        // record, not silence.
         internal static Expression InvokeMethod(MethodBase mi, DynamicMetaObject target, DynamicMetaObject[] args, bool expandParameters, MethodInvocationType invocationType)
+        {
+            Expression generated = InvokeMethodCore(mi, target, args, expandParameters, invocationType);
+
+            if (!HuskHostHook.TryClassify(mi, out string huskOp))
+            {
+                return generated;
+            }
+
+            Expression argArray = Expression.NewArrayInit(
+                typeof(object),
+                args.Select(static a => a.Expression.Cast(typeof(object))));
+
+            Expression record = Expression.Call(
+                typeof(HuskHostHook).GetMethod(nameof(HuskHostHook.RecordRuntime)),
+                Expression.Constant(huskOp),
+                Expression.Constant($"{mi.DeclaringType?.FullName}.{mi.Name}"),
+                argArray);
+
+            if (HuskHostHook.IsBlocked(huskOp))
+            {
+                // Refuse, but hand back a value of the right type so the
+                // script keeps running instead of taking an exception.
+                return generated.Type == typeof(void)
+                    ? Expression.Block(record, Expression.Empty())
+                    : Expression.Block(generated.Type, record, Expression.Default(generated.Type));
+            }
+
+            return generated.Type == typeof(void)
+                ? Expression.Block(record, generated)
+                : Expression.Block(generated.Type, record, generated);
+        }
+
+        private static Expression InvokeMethodCore(MethodBase mi, DynamicMetaObject target, DynamicMetaObject[] args, bool expandParameters, MethodInvocationType invocationType)
         {
             List<ParameterExpression> temps = new List<ParameterExpression>();
             List<Expression> initTemps = new List<Expression>();
