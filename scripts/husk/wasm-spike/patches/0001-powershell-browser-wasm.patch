diff --git a/src/System.Management.Automation/engine/Utils.cs b/src/System.Management.Automation/engine/Utils.cs
index 1ad23a4..301c3ff 100644
--- a/src/System.Management.Automation/engine/Utils.cs
+++ b/src/System.Management.Automation/engine/Utils.cs
@@ -484,7 +484,20 @@ namespace System.Management.Automation
         {
             // Use the location of SMA.dll as the application base.
             Assembly assembly = typeof(PSObject).Assembly;
-            return Path.GetDirectoryName(assembly.Location);
+            string location = assembly.Location;
+
+            // wasm port: assemblies loaded from the browser boot manifest have
+            // no on-disk location, so Location is "" and GetDirectoryName("")
+            // returns null. Everything downstream feeds that straight into
+            // Path.Combine, so $PSHOME has to resolve to something real.
+            // AppContext.BaseDirectory is "/" under mono-wasm, which is a
+            // valid root in the in-memory filesystem.
+            if (string.IsNullOrEmpty(location))
+            {
+                return AppContext.BaseDirectory;
+            }
+
+            return Path.GetDirectoryName(location);
         }
 
         private static string[] s_productFolderDirectories;
