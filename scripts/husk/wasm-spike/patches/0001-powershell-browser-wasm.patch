diff --git a/src/System.Management.Automation/engine/HuskHostHook.cs b/src/System.Management.Automation/engine/HuskHostHook.cs
new file mode 100644
index 0000000..975c678
--- /dev/null
+++ b/src/System.Management.Automation/engine/HuskHostHook.cs
@@ -0,0 +1,438 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+//
+// wasm port addition: a single chokepoint for host-reaching .NET calls.
+//
+// Proxy cmdlets and functions are bypassable - [Net.WebClient]::new() walks
+// straight past a proxied New-Object, and a sample can simply delete the
+// proxy. Recording here instead means it does not matter how the script
+// reached the method: every .NET method call in PowerShell goes through
+// DotNetAdapter.AuxiliaryMethodInvoke, so a hook there sees all of them.
+//
+// A bypass should produce a record, not silence. Silence is the failure mode
+// that makes a sandbox untrustworthy.
+
+using System.Collections;
+using System.Collections.Generic;
+using System.Reflection;
+using System.Text;
+
+namespace System.Management.Automation
+{
+    /// <summary>
+    /// Host-call interception for the browser build. The host wires up
+    /// <see cref="OnHostCall"/>; the engine calls it from the member binder.
+    /// </summary>
+    public static class HuskHostHook
+    {
+        /// <summary>Called with (op, nativeSignature, renderedArguments).</summary>
+        public static Action<string, string, string[]> OnHostCall;
+
+        /// <summary>
+        /// The same, for the cmdlet layer. Separate so the analyst can tell
+        /// where a record came from: a binder record means the script reached
+        /// for a .NET method, a cmdlet record means it used the cmdlet. The
+        /// two see different things and have different blind spots, and a
+        /// timeline that blurs them is harder to trust, not easier.
+        /// </summary>
+        public static Action<string, string, string[]> OnCmdletCall;
+
+        /// <summary>
+        /// When true, intercepted calls whose op is in the blocked set return
+        /// null instead of running. Filesystem calls are deliberately not
+        /// blocked: letting a sample drop its payload into the in-memory
+        /// filesystem is how the analyst gets to extract it afterwards.
+        /// </summary>
+        public static bool BlockNetwork = true;
+
+        // Declaring type full name -> (method name prefix -> op). Checked only
+        // after a namespace fast-path, because this runs on every method call
+        // PowerShell makes.
+        private static readonly Dictionary<string, string> s_typeOps = new(StringComparer.Ordinal)
+        {
+            ["System.Net.WebClient"] = "network",
+            ["System.Net.Http.HttpClient"] = "network.http",
+            ["System.Net.WebRequest"] = "network.http",
+            ["System.Net.HttpWebRequest"] = "network.http",
+            ["System.Net.Sockets.TcpClient"] = "network.connect",
+            ["System.Net.Sockets.Socket"] = "network.connect",
+            ["System.IO.File"] = "filesystem",
+            ["System.IO.Directory"] = "filesystem",
+            ["System.IO.FileStream"] = "filesystem.write",
+            ["System.Diagnostics.Process"] = "process.start",
+            ["System.Reflection.Assembly"] = "assembly.load",
+            ["System.AppDomain"] = "assembly.load",
+        };
+
+        /// <summary>
+        /// Cheap rejection for the overwhelming majority of calls. Anything
+        /// not under these namespaces cannot reach the host.
+        /// </summary>
+        private static bool MayReachHost(string typeName)
+        {
+            return typeName.Length > 7
+                && (typeName.StartsWith("System.Net.", StringComparison.Ordinal)
+                    || typeName.StartsWith("System.IO.", StringComparison.Ordinal)
+                    || typeName.StartsWith("System.Diagnostics.", StringComparison.Ordinal)
+                    || typeName.StartsWith("System.Reflection.", StringComparison.Ordinal)
+                    || typeName.StartsWith("Microsoft.Win32.", StringComparison.Ordinal)
+                    || typeName.Equals("System.AppDomain", StringComparison.Ordinal));
+        }
+
+        /// <summary>
+        /// Classifies a call. Returns false for everything that cannot reach
+        /// the host, which is almost everything.
+        /// </summary>
+        internal static bool Classify(MethodBase method, out string op)
+        {
+            op = null;
+            Type declaring = method?.DeclaringType;
+            string typeName = declaring?.FullName;
+            if (typeName is null || !MayReachHost(typeName))
+            {
+                return false;
+            }
+
+            if (typeName.StartsWith("Microsoft.Win32.Registry", StringComparison.Ordinal))
+            {
+                op = method.Name.StartsWith("Set", StringComparison.Ordinal)
+                    || method.Name.StartsWith("Create", StringComparison.Ordinal)
+                        ? "registry.write"
+                        : method.Name.StartsWith("Delete", StringComparison.Ordinal)
+                            ? "registry.delete"
+                            : "registry.read";
+                return true;
+            }
+
+            if (!s_typeOps.TryGetValue(typeName, out string family))
+            {
+                return false;
+            }
+
+            op = family switch
+            {
+                "network" => method.Name switch
+                {
+                    "DownloadFile" or "DownloadFileAsync" => "network.download",
+                    "UploadString" or "UploadData" or "UploadFile" => "network.upload",
+                    _ => "network.http",
+                },
+                "filesystem" => method.Name switch
+                {
+                    var n when n.StartsWith("Write", StringComparison.Ordinal)
+                        || n.StartsWith("Append", StringComparison.Ordinal)
+                        || n.StartsWith("Create", StringComparison.Ordinal) => "filesystem.write",
+                    var n when n.StartsWith("Delete", StringComparison.Ordinal) => "filesystem.delete",
+                    var n when n.StartsWith("Move", StringComparison.Ordinal) => "filesystem.move",
+                    var n when n.StartsWith("Copy", StringComparison.Ordinal) => "filesystem.copy",
+                    var n when n.StartsWith("Read", StringComparison.Ordinal)
+                        || n.StartsWith("Open", StringComparison.Ordinal) => "filesystem.read",
+                    _ => "filesystem.read",
+                },
+                _ => family,
+            };
+
+            return true;
+        }
+
+        /// <summary>
+        /// Called from compiled script. The DLR binder emits a direct call to
+        /// the resolved method, so the interpreted path in CoreAdapter never
+        /// runs for compiled script - this is the one that actually fires.
+        /// </summary>
+        public static void RecordRuntime(string op, string nativeSignature, object[] arguments)
+        {
+            Action<string, string, string[]> sink = OnHostCall;
+            if (sink is null) { return; }
+
+            try
+            {
+                var rendered = new string[arguments?.Length ?? 0];
+                for (int i = 0; i < rendered.Length; i++)
+                {
+                    object a = arguments[i];
+                    rendered[i] = a switch
+                    {
+                        null => "$null",
+                        string str => str,
+                        byte[] b => $"<byte[{b.Length}]>",
+                        _ => a.ToString(),
+                    };
+                }
+
+                sink(op, nativeSignature, rendered);
+            }
+            catch (Exception)
+            {
+                // Best effort; never take the run down over a log line.
+            }
+        }
+
+
+        // ---------------------------------------------------------------
+        // Cmdlet-level capture
+        // ---------------------------------------------------------------
+        //
+        // The binder hook sees what the *script* calls. A cmdlet's own
+        // internals are invisible to it, so Set-ItemProperty writing a Run key
+        // and Out-File dropping a payload produced no record at all. This
+        // table closes that, from inside CommandProcessor where every cmdlet
+        // invocation passes with its parameters bound.
+        //
+        // The op is not always decidable from the cmdlet name: the item
+        // cmdlets are provider-generic, so `New-Item` is a file or a registry
+        // key depending on the path. That decision is made per call, from the
+        // path itself.
+
+        /// <summary>Which parameters carry the thing being acted on, in order of preference.</summary>
+        private static readonly string[] s_pathParameters =
+        {
+            "Path", "LiteralPath", "FilePath", "Destination", "NewName",
+            "Uri", "Source", "OutFile", "Name", "InputObject",
+        };
+
+        /// <summary>Cmdlet name -> op, for cmdlets whose family is not in doubt.</summary>
+        private static readonly Dictionary<string, string> s_cmdletOps = new(StringComparer.OrdinalIgnoreCase)
+        {
+            ["Out-File"] = "filesystem.write",
+            ["Set-Content"] = "filesystem.write",
+            ["Add-Content"] = "filesystem.append",
+            ["Get-Content"] = "filesystem.read",
+            ["Clear-Content"] = "filesystem.write",
+            ["Export-Csv"] = "filesystem.write",
+            ["Export-Clixml"] = "filesystem.write",
+            ["Start-Process"] = "process.start",
+            ["Stop-Process"] = "process.kill",
+            ["Get-Process"] = "process.list",
+            ["Wait-Process"] = "process.list",
+            ["Invoke-WebRequest"] = "network.http",
+            ["Invoke-RestMethod"] = "network.http",
+            ["Start-BitsTransfer"] = "network.download",
+            ["New-Service"] = "persistence.service",
+            ["Set-Service"] = "persistence.service",
+            ["Start-Service"] = "persistence.service",
+            ["Register-ScheduledTask"] = "persistence.scheduled-task",
+            ["New-ScheduledTask"] = "persistence.scheduled-task",
+            ["Start-Sleep"] = "timing.sleep",
+            ["Add-Type"] = "assembly.define-type",
+            ["Import-Module"] = "assembly.load",
+            ["Get-WmiObject"] = "wmi.query",
+            ["Get-CimInstance"] = "wmi.query",
+            ["Invoke-WmiMethod"] = "wmi.invoke",
+            ["Invoke-CimMethod"] = "wmi.invoke",
+            ["Register-WmiEvent"] = "wmi.subscribe",
+        };
+
+        /// <summary>
+        /// Cmdlets whose family depends on the provider the path names:
+        /// cmdlet name -> (filesystem op, registry op).
+        /// </summary>
+        private static readonly Dictionary<string, (string File, string Registry)> s_providerCmdletOps =
+            new(StringComparer.OrdinalIgnoreCase)
+            {
+                ["New-Item"] = ("filesystem.write", "registry.write"),
+                ["Set-Item"] = ("filesystem.write", "registry.write"),
+                ["Remove-Item"] = ("filesystem.delete", "registry.delete"),
+                ["Clear-Item"] = ("filesystem.write", "registry.write"),
+                ["Get-Item"] = ("filesystem.read", "registry.read"),
+                ["Set-ItemProperty"] = ("filesystem.write", "registry.write"),
+                ["New-ItemProperty"] = ("filesystem.write", "registry.write"),
+                ["Remove-ItemProperty"] = ("filesystem.delete", "registry.delete"),
+                ["Clear-ItemProperty"] = ("filesystem.write", "registry.write"),
+                ["Get-ItemProperty"] = ("filesystem.read", "registry.read"),
+                ["Get-ItemPropertyValue"] = ("filesystem.read", "registry.read"),
+                ["Get-ChildItem"] = ("filesystem.list", "registry.enumerate"),
+                ["Test-Path"] = ("filesystem.exists", "registry.read"),
+                ["Copy-Item"] = ("filesystem.copy", "registry.write"),
+                ["Move-Item"] = ("filesystem.move", "registry.write"),
+                ["Rename-Item"] = ("filesystem.move", "registry.write"),
+                ["Rename-ItemProperty"] = ("filesystem.write", "registry.write"),
+            };
+
+        /// <summary>
+        /// Every way a sample spells a registry path. The provider-qualified
+        /// and native forms both turn up, because droppers are copied from
+        /// whatever worked.
+        /// </summary>
+        private static bool IsRegistryPath(string path)
+        {
+            if (string.IsNullOrEmpty(path)) { return false; }
+
+            return path.StartsWith("HK", StringComparison.OrdinalIgnoreCase)
+                || path.StartsWith("Registry::", StringComparison.OrdinalIgnoreCase)
+                || path.IndexOf("Microsoft.PowerShell.Core\\Registry::", StringComparison.OrdinalIgnoreCase) >= 0;
+        }
+
+        /// <summary>
+        /// Records one cmdlet invocation. Called for every cmdlet in every
+        /// pipeline, so it rejects on a dictionary lookup and never throws.
+        /// </summary>
+        /// <param name="lastSignature">
+        /// What this invocation recorded last. The caller holds it per command,
+        /// because the hook fires both before BeginProcessing - which is the
+        /// only chance for a cmdlet that throws there, such as Start-Process
+        /// in a browser - and once per pipeline object, where a parameter bound
+        /// from the pipeline may have changed the path. Comparing against it
+        /// records each distinct call once and a repeated one not at all.
+        /// </param>
+        public static void RecordCmdlet(string cmdletName, IDictionary boundParameters, ref string lastSignature)
+        {
+            Action<string, string, string[]> sink = OnCmdletCall;
+            if (sink is null || string.IsNullOrEmpty(cmdletName))
+            {
+                return;
+            }
+
+            try
+            {
+                string op = null;
+                if (s_providerCmdletOps.TryGetValue(cmdletName, out var byProvider))
+                {
+                    string path = FirstPath(boundParameters);
+                    op = IsRegistryPath(path) ? byProvider.Registry : byProvider.File;
+                }
+                else if (!s_cmdletOps.TryGetValue(cmdletName, out op))
+                {
+                    return;
+                }
+
+                string[] rendered = RenderParameters(boundParameters);
+                string signature = op + "|" + string.Join("\u001f", rendered);
+                if (string.Equals(signature, lastSignature, StringComparison.Ordinal))
+                {
+                    return;
+                }
+
+                lastSignature = signature;
+                sink(op, cmdletName, rendered);
+            }
+            catch (Exception)
+            {
+                // Best effort; never take a pipeline down over a log line.
+            }
+        }
+
+        private static string FirstPath(IDictionary boundParameters)
+        {
+            if (boundParameters is null) { return null; }
+
+            foreach (string name in s_pathParameters)
+            {
+                if (boundParameters.Contains(name))
+                {
+                    return Render(boundParameters[name]);
+                }
+            }
+
+            return null;
+        }
+
+        /// <summary>
+        /// The bound parameters as name=value, so the analyst sees the call as
+        /// the sample wrote it rather than as a normalised op alone.
+        /// </summary>
+        private static string[] RenderParameters(IDictionary boundParameters)
+        {
+            if (boundParameters is null) { return Array.Empty<string>(); }
+
+            var rendered = new List<string>(boundParameters.Count);
+            foreach (DictionaryEntry entry in boundParameters)
+            {
+                rendered.Add($"{entry.Key}={Render(entry.Value)}");
+            }
+
+            return rendered.ToArray();
+        }
+
+        private static string Render(object value)
+        {
+            switch (value)
+            {
+                case null:
+                    return "$null";
+                case string str:
+                    return str;
+                case byte[] bytes:
+                    return $"<byte[{bytes.Length}]>";
+                case PSObject wrapped:
+                    return Render(wrapped.BaseObject);
+                case IEnumerable items when value is not string:
+                    var sb = new StringBuilder();
+                    foreach (object item in items)
+                    {
+                        if (sb.Length > 0) { sb.Append(','); }
+                        if (sb.Length > 240) { sb.Append('…'); break; }
+                        sb.Append(item is null ? "$null" : item.ToString());
+                    }
+
+                    return sb.ToString();
+                default:
+                    return value.ToString();
+            }
+        }
+
+        /// <summary>True when an op should be refused rather than run.</summary>
+        ///
+        /// Two different reasons, deliberately collapsed into one answer.
+        /// Network is a *policy* choice the analyst makes. Registry and process
+        /// are not a choice: Microsoft.Win32.Registry and
+        /// System.Diagnostics.Process both throw
+        /// PlatformNotSupportedException in a browser, so running them aborts
+        /// the sample at the exact moment it reveals its persistence or its
+        /// child process. Refusing after recording keeps the run alive, which
+        /// is the whole point of a sandbox that captures rather than performs.
+        public static bool IsBlocked(string op)
+        {
+            if (op is null) { return false; }
+
+            return (BlockNetwork && op.StartsWith("network.", StringComparison.Ordinal))
+                || op.StartsWith("registry.", StringComparison.Ordinal)
+                || op.StartsWith("process.", StringComparison.Ordinal);
+        }
+
+        /// <summary>Classification, for the binder.</summary>
+        public static bool TryClassify(MethodBase method, out string op) => Classify(method, out op);
+
+        /// <summary>
+        /// Records a call and says whether the engine should skip running it.
+        /// Never throws: a failure to record must not abort evaluation.
+        /// </summary>
+        internal static bool Intercept(MethodBase method, object[] arguments)
+        {
+            if (OnHostCall is null || !Classify(method, out string op))
+            {
+                return false;
+            }
+
+            try
+            {
+                var rendered = new string[arguments?.Length ?? 0];
+                for (int i = 0; i < rendered.Length; i++)
+                {
+                    object a = arguments[i];
+                    rendered[i] = a switch
+                    {
+                        null => "$null",
+                        string s => s,
+                        byte[] b => $"<byte[{b.Length}]>",
+                        _ => a.ToString(),
+                    };
+                }
+
+                OnHostCall(op, $"{method.DeclaringType.FullName}.{method.Name}", rendered);
+            }
+            catch (Exception)
+            {
+                // Recording is best effort. Losing a log line is bad; taking
+                // the run down with it is worse.
+            }
+
+            // Filesystem calls run for real - into the in-memory filesystem,
+            // which is how dropped payloads become extractable. Everything
+            // IsBlocked covers is refused here rather than deeper down, so the
+            // sample sees a default value instead of an exception and keeps
+            // going.
+            return IsBlocked(op);
+        }
+    }
+}
